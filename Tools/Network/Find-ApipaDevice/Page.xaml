<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- notice bar -->
            <RowDefinition Height="Auto"/>  <!-- options -->
            <RowDefinition Height="Auto"/>  <!-- start / cancel / progress -->
            <RowDefinition Height="*"/>     <!-- results -->
            <RowDefinition Height="Auto"/>  <!-- result actions -->
            <RowDefinition Height="Auto"/>  <!-- log -->
        </Grid.RowDefinitions>

        <!-- Notice bar: shown when the selected adapter has no APIPA address -->
        <Border Grid.Row="0" x:Name="bdrNotice" Style="{DynamicResource NoticeBarStyle}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="txtNotice" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="btnAssignApipa" Content="Add 169.254.1.1" Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Right" x:Name="btnCopyCommand" Content="Copy" Margin="6,0,0,0"
                            ToolTip="Copy the command to the clipboard"/>
                    <TextBox x:Name="txtNoticeCommand" IsReadOnly="True" FontFamily="Consolas"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Options -->
        <GroupBox Grid.Row="1" Header="Options">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Network adapter:" Target="{Binding ElementName=cmbAdapter}"/>
                <DockPanel Grid.Row="0" Grid.Column="1">
                    <Button DockPanel.Dock="Right" x:Name="btnRefresh" Style="{DynamicResource RefreshButtonStyle}"
                            ToolTip="Refresh the adapter list (e.g. after plugging in a USB network adapter)"/>
                    <ComboBox x:Name="cmbAdapter" DisplayMemberPath="DisplayName"/>
                </DockPanel>

                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="chkShowAll"
                          Content="Show virtual, VPN, Bluetooth and disconnected adapters"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Subnet (CIDR):" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <ComboBox x:Name="cmbSubnet" IsEditable="True" Width="190"
                              ToolTip="Range to scan, /16 to /32. A /16 takes about 2 minutes, a /24 about one second."/>
                    <Label Content="Timeout (ms):" Margin="20,0,0,0"/>
                    <ComboBox x:Name="cmbTimeout" IsEditable="True" Width="90"
                              ToolTip="Ping timeout per address (50-10000 ms)"/>
                </StackPanel>

                <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                    <CheckBox x:Name="chkStopOnFirst" Content="Stop after the first device"
                              ToolTip="Stop the scan after the first block that contains a device"/>
                    <CheckBox x:Name="chkArp" Content="Include devices that only answer ARP"
                              ToolTip="Also report devices that block ping but appear in the ARP cache"/>
                    <CheckBox x:Name="chkVendor" Content="Resolve vendor (offline OUI table)"/>
                </WrapPanel>
            </Grid>
        </GroupBox>

        <!-- Start / cancel / progress -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <DockPanel>
                <Button x:Name="btnStart" Content="Start scan" IsDefault="True" FontWeight="SemiBold"/>
                <Button x:Name="btnCancel" Content="Cancel" IsEnabled="False"/>
                <ProgressBar x:Name="pbProgress" Minimum="0" Maximum="100" Margin="6,0,0,0"/>
            </DockPanel>
            <TextBlock x:Name="txtStatus" Margin="0,4,0,0" Text="Ready."/>
        </StackPanel>

        <!-- Results -->
        <DataGrid Grid.Row="3" x:Name="dgResults">
            <DataGrid.Columns>
                <DataGridTextColumn Header="IP address"   Binding="{Binding IPAddress}"      Width="130"/>
                <DataGridTextColumn Header="MAC address"  Binding="{Binding MacAddress}"     Width="140"/>
                <DataGridTextColumn Header="Vendor"       Binding="{Binding Vendor}"         Width="*"/>
                <DataGridTextColumn Header="Interface"    Binding="{Binding InterfaceAlias}" Width="140"/>
                <DataGridTextColumn Header="Detected by"  Binding="{Binding DetectedBy}"     Width="90"/>
                <DataGridTextColumn Header="Response (ms)" Binding="{Binding ResponseTimeMs}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Result actions -->
        <WrapPanel Grid.Row="4" Margin="0,6,0,0">
            <Button x:Name="btnCopy" Content="Copy" ToolTip="Copy the selected rows (or all rows) as tab-separated text"/>
            <Button x:Name="btnExport" Content="Export CSV…"/>
            <Button x:Name="btnOpenWeb" Content="Open web UI" IsEnabled="False" ToolTip="Open http://&lt;IP&gt; of the selected device"/>
            <Button x:Name="btnPing" Content="Ping -t" IsEnabled="False" ToolTip="Open a console with a continuous ping to the selected device"/>
            <Button x:Name="btnClear" Content="Clear"/>
        </WrapPanel>

        <!-- Log -->
        <Expander Grid.Row="5" x:Name="expLog" Header="Log" Margin="0,8,0,0">
            <TextBox x:Name="txtLog" Style="{DynamicResource LogBoxStyle}" Height="120" Margin="0,4,0,0"/>
        </Expander>
    </Grid>
</UserControl>
