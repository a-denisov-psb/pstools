<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- target -->
            <RowDefinition Height="Auto"/>  <!-- start / cancel / progress -->
            <RowDefinition Height="*"/>     <!-- results -->
            <RowDefinition Height="Auto"/>  <!-- result actions -->
            <RowDefinition Height="Auto"/>  <!-- history -->
            <RowDefinition Height="Auto"/>  <!-- log -->
        </Grid.RowDefinitions>

        <!-- Target -->
        <GroupBox Grid.Row="0" Header="Target">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Host:" Target="{Binding ElementName=cmbHost}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbHost" IsEditable="True"
                          ToolTip="Host name, IPv4 or IPv6 address. The list contains the hosts from the history."/>

                <Label Grid.Row="1" Grid.Column="0" Content="Ports:" Margin="0,4,0,0" Target="{Binding ElementName=txtPorts}"/>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                    <ComboBox DockPanel.Dock="Right" x:Name="cmbPreset" Width="230" Margin="6,0,0,0" DisplayMemberPath="Display"
                              ToolTip="Fill in the ports and protocol of a common service"/>
                    <Label DockPanel.Dock="Right" Content="Common services:" Margin="12,0,0,0"/>
                    <TextBox x:Name="txtPorts" FontFamily="Consolas"
                             ToolTip="Single ports and ranges, e.g. 3389 or 80,443 or 8000-8010 (at most 1024 ports)"/>
                </DockPanel>

                <Label Grid.Row="2" Grid.Column="0" Content="Protocol:" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="rbTcp" Content="TCP" GroupName="Protocol" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbUdp" Content="UDP" GroupName="Protocol" VerticalAlignment="Center" Margin="12,0,0,0"
                                 ToolTip="UDP has no handshake: without an answer the port is reported as Open|Filtered"/>
                    <RadioButton x:Name="rbBoth" Content="TCP + UDP" GroupName="Protocol" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Label Content="Timeout (ms):" Margin="30,0,0,0"/>
                    <ComboBox x:Name="cmbTimeout" IsEditable="True" Width="90"
                              ToolTip="Time to wait for an answer per port (100-60000 ms). Windows needs about 2 s to report a refused TCP connection, so below 2500 ms closed ports may show as Filtered."/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Start / cancel / progress -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <DockPanel>
                <Button x:Name="btnStart" Content="Check" IsDefault="True" FontWeight="SemiBold"/>
                <Button x:Name="btnCancel" Content="Cancel" IsEnabled="False"/>
                <ProgressBar x:Name="pbProgress" Minimum="0" Maximum="100" Margin="6,0,0,0"/>
            </DockPanel>
            <TextBlock x:Name="txtStatus" Margin="0,4,0,0" Text="Ready." TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Results -->
        <DataGrid Grid.Row="2" x:Name="dgResults" MinHeight="80">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Protocol"       Binding="{Binding Protocol}"       Width="65"/>
                <DataGridTextColumn Header="Port"           Binding="{Binding Port}"           Width="55"/>
                <DataGridTextColumn Header="Service"        Binding="{Binding Service}"        Width="130"/>
                <DataGridTextColumn Header="State"          Binding="{Binding State}"          Width="95"/>
                <DataGridTextColumn Header="Time (ms)"      Binding="{Binding ResponseTimeMs}" Width="70"/>
                <DataGridTextColumn Header="Remote address" Binding="{Binding RemoteAddress}"  Width="120"/>
                <DataGridTextColumn Header="Source address" Binding="{Binding SourceAddress}"  Width="120"/>
                <DataGridTextColumn Header="Interface"      Binding="{Binding InterfaceAlias}" Width="120"/>
                <DataGridTextColumn Header="Detail"         Binding="{Binding Detail}"         Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Result actions -->
        <WrapPanel Grid.Row="3" Margin="0,6,0,0">
            <Button x:Name="btnCopy" Content="Copy" ToolTip="Copy the selected rows (or all rows) as tab-separated text"/>
            <Button x:Name="btnExport" Content="Export CSV…"/>
            <Button x:Name="btnClear" Content="Clear"/>
        </WrapPanel>

        <!-- History -->
        <GroupBox Grid.Row="4" x:Name="grpHistory" Header="History (last 20)" Margin="0,8,0,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="btnRerun" Content="Check again" IsEnabled="False"
                            ToolTip="Load the selected check into the form and run it (or double-click the row)"/>
                    <Button x:Name="btnRemoveHistory" Content="Remove" IsEnabled="False" ToolTip="Remove the selected entries from the history"/>
                    <Button x:Name="btnClearHistory" Content="Clear history"/>
                </WrapPanel>
                <DataGrid x:Name="dgHistory" Height="170">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time"     Binding="{Binding Time}"         Width="130"/>
                        <DataGridTextColumn Header="Host"     Binding="{Binding ComputerName}" Width="170"/>
                        <DataGridTextColumn Header="Ports"    Binding="{Binding Ports}"        Width="150"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}"     Width="75"/>
                        <DataGridTextColumn Header="Result"   Binding="{Binding Result}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- Log -->
        <Expander Grid.Row="5" x:Name="expLog" Header="Log" Margin="0,8,0,0">
            <TextBox x:Name="txtLog" Style="{DynamicResource LogBoxStyle}" Height="120" Margin="0,4,0,0"/>
        </Expander>
    </Grid>
</UserControl>
